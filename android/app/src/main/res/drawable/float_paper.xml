<?xml version="1.0" encoding="utf-8"?>
<!--
  漂浮的纸条（头图里的视觉主角）。

  参考图里这个位置是一个**角色形象**，它让整屏有个"活物"。
  我们没有角色，就用产品自己的主角顶上 —— 一张微微倾斜的白纸条。

  两层：底层是柔和投影，上层是纸本体。
  投影用深蓝紫而不是纯黑：纯黑投影在紫色渐变上会发灰发脏。
  圆角 8dp 刻意做小，真实纸条的角没那么圆。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 投影：往下挪一点，范围比纸略大一点，边缘虚 -->
    <item
        android:bottom="4dp"
        android:left="2dp"
        android:right="2dp"
        android:top="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#33120F2E" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- 纸本体 -->
    <item android:bottom="8dp" android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/paper_white_fill" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
