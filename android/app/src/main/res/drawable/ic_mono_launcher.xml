<!--
  主题图标的单色层（Android 13+ Monochrome）。

  必须用纯色矢量：系统会把这一层强制单色化并按主题上色。
  彩色插画放这里会被压成灰块，所以另外画了一张纸条轮廓。

  纸身和折角用**一条路径**表达，而不是两个白色图形叠加 ——
  两块抗锯齿边缘叠在一起会露出一条浅色缝隙。
  折角处故意留出缺口，做出"纸被折起来"的观感。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M33,30 L61,30 L75,44 L75,78 A4,4 0 0 1 71,82 L33,82 A4,4 0 0 1 29,78 L29,34 A4,4 0 0 1 33,30 Z M61,30 L61,44 L75,44 Z" />
</vector>
