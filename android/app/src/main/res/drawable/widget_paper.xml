<?xml version="1.0" encoding="utf-8"?>
<!-- 纸条底板：淡黄纸张 + 圆角 + 细边。小部件里用 setInt("setBackgroundResource") 动态着色 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/paper_yellow" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/paper_yellow_dark" />
</shape>
