<?xml version="1.0" encoding="utf-8"?>
<!--
  写纸条页（横屏）。

  ## 为什么横屏是左右分栏

  横屏的物理形状是「宽 2712 x 高 1220」——宽度富余、高度紧缺。
  工具栏放上下会吃掉约 40% 的高度，纸张只剩 66%。
  放到左右两侧后纸张能拿到 96% 的高度，绘制面积多出近一半。

  原则：**工具栏放在空间富余的那一维**。

  ## id 必须与竖屏完全一致

  Android 旋转时按 view id 恢复控件状态，
  同一个 id 在两个布局里必须是同一种控件类型，
  否则会抛 ClassCastException 闪退。
  这里所有 id 与竖屏布局一一对应。
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:padding="6dp">

    <!-- ===== 左侧栏：纸张样式 + 方向 ===== -->
    <LinearLayout
        android:id="@+id/topbar"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/paperGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/paperWhite"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="64dp"
                android:layout_height="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/paper_white"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/paperGrid"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="64dp"
                android:layout_height="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/paper_grid"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/paperCream"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="64dp"
                android:layout_height="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/paper_cream"
                android:textSize="11sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOrientation"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="64dp"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/orient_portrait"
            android:textSize="11sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRecipient"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="64dp"
        android:layout_height="38dp"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:maxLines="1"
        android:minWidth="0dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/recipient_pick"
        android:textColor="@color/aurora"
        android:textSize="11sp" />

        <!--
          贴纸库入口。

          竖屏是横向一行排得开，横屏的右侧栏只有 64dp 宽，
          所以这里单独占一格竖着放。
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSticker"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="64dp"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/tool_sticker"
            android:textColor="@color/ink_secondary"
            android:textSize="11sp" />

        <!--
          「删除贴纸」和「锁定贴纸」。

          竖屏里这两颗在底部抽屉中，只在选中贴纸时出现。
          横屏必须也有 —— ComposeActivity 在 onCreate 里直接
          findViewById 取 btnStickerDelete，缺了它旋转到横屏会
          立刻抛 NPE 闪退（这正是用户报的"选择横屏时闪退"）。
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStickerDelete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="64dp"
            android:layout_height="38dp"
            android:layout_marginTop="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/tool_sticker_remove"
            android:textColor="@color/danger"
            android:textSize="11sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStickerLock"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="64dp"
            android:layout_height="38dp"
            android:layout_marginTop="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/sticker_lock"
            android:textColor="@color/aurora"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- 返回。横屏也留一颗，和竖屏一致 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="64dp"
            android:layout_height="38dp"
            android:layout_marginTop="6dp"
            android:contentDescription="@string/action_back"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/action_back"
            android:textColor="@color/ink_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ===== 画布：左右栏之间，上下贴边 ===== -->
    <LinearLayout
        android:id="@+id/paper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/paper_white"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/painterbar"
        app:layout_constraintStart_toEndOf="@id/topbar"
        app:layout_constraintTop_toTopOf="parent">

        <EditText
            android:id="@+id/input_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="top|start"
            android:hint="@string/hint_text"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="2"
            android:minLines="1"
            android:textColor="@color/ink_on_paper"
            android:textColorHint="@color/hint_on_paper"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:background="@color/divider" />

        <com.notedrop.demo.ui.DoodleView
            android:id="@+id/doodle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvZoomHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/pill_bg"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:text="@string/zoom_active"
        android:textColor="@color/aurora"
        android:textSize="10sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/paper"
        app:layout_constraintEnd_toEndOf="@id/paper" />

    <!-- ===== 右侧栏：工具 ===== -->
    <LinearLayout
        android:id="@+id/painterbar"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toolGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolPen"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/tool_pen"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolEraser"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/tool_eraser"
                android:textSize="11sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnColor"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginTop="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/tool_color"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWidth"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginTop="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/width_mid"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTracing"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginTop="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/tool_tracing"
            android:textColor="@color/ink_secondary"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZoom"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/tool_zoom"
            android:textColor="@color/ink_secondary"
            android:textSize="11sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUndo"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/action_undo"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClear"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/action_clear"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            style="@style/PrimaryAction"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:minWidth="96dp"
            android:text="@string/action_send"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/colorRow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
