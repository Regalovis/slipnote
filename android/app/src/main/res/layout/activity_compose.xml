<?xml version="1.0" encoding="utf-8"?>
<!--
  写纸条页（竖屏）。

  ## 这一版的核心改动：工具栏改成可拖拽的抽屉

  上一版是"顶部一行 + 底部两行"，按钮一共十几个，平铺在上下两端。
  用户的原话是：

  > 这个版本还是有点太压缩绘画空间了，那个返回按钮、"写一张"
  > 以及下方按钮占比有点大，需要把最重要的屏幕资源给画板。
  > 下方的这些工具可不可以做成那种隐藏在边栏可以滑动画出来，
  > 不用就滑回去隐藏只留一个可以拖拽边框的那种。

  所以现在：

  ```
  ┌────────────────────────┐
  │ ← 返回      写一张   ⤢  │  ← 压到 40dp，只保留必要信息
  ├────────────────────────┤
  │                        │
  │        画  布           │  ← 占屏约 88%
  │                        │
  │                        │
  ├────────────────────────┤
  │         ═══            │  ← 收起时只剩这根把手（30dp）
  └────────────────────────┘
  ```

  抽屉能**拖**：点把手切换开合，上下拖动跟手，松手吸附到最近的一端。
  点画布也会自动收起 —— 用户一落笔，工具就让位。

  ## 为什么把手要能被拖，而不是只做成两个状态

  只做开/关的话，用户想"我只想调个笔粗细"也得整块面板弹出来再收回去。
  跟手拖拽让人自己决定要多少空间，这是移动端面板的常规手感。

  ## 日夜切换按钮被删掉了

  之前我在页面上放了个切换日夜的按钮 —— 那是**演示用的控件，不该出现在真机**。
  日夜跟随系统设置，不是 App 的功能。
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/desk">

    <!-- ========== 顶部：返回 / 标题 / 收件人 / 视角 ========== -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        style="@style/TopBarButton"
        android:layout_marginStart="6dp"
        android:layout_marginTop="4dp"
        android:contentDescription="@string/action_back"
        app:icon="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:letterSpacing="-0.01"
        android:text="@string/compose_title"
        android:textColor="@color/ink_on_paper"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <!--
      收件人。

      放在标题右边、同一行 —— 之前它在最右边单独占一个按钮位，
      和方向按钮一起把这一行撑得很高。现在"发给谁"就是标题的补充，
      两者本来就是一句话："写一张 · 发给 果果"。
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRecipient"
        style="@style/TopBarButton"
        android:layout_marginStart="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/recipient_pick"
        android:textColor="@color/aurora"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/tvTitle"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <!-- 视角按钮：横竖版在这里切 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOrientation"
        style="@style/TopBarButton"
        android:layout_marginEnd="6dp"
        android:text="@string/orient_portrait"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <!--
      纸张选择。

      收进抽屉里了 —— 换纸是"开写之前调一次"的动作，
      不是每次都碰的开关，不值得常驻在顶上占一行。
    -->

    <!-- ========== 画布 ========== -->

    <LinearLayout
        android:id="@+id/paper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/paper_white"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintBottom_toTopOf="@id/drawer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <EditText
            android:id="@+id/input_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="top|start"
            android:hint="@string/hint_text"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:lineSpacingMultiplier="1.3"
            android:maxLines="4"
            android:minLines="1"
            android:textColor="@color/ink_on_paper"
            android:textColorHint="@color/hint_on_paper"
            android:textSize="17sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@color/divider" />

        <com.notedrop.demo.ui.DoodleView
            android:id="@+id/doodle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent" />
    </LinearLayout>

    <!-- 缩放提示：只在放大时出现，压在画布右下角 -->
    <TextView
        android:id="@+id/tvZoomHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/pill_bg"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:text="@string/zoom_active"
        android:textColor="@color/aurora"
        android:textSize="11sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/drawer"
        app:layout_constraintEnd_toEndOf="@id/paper" />

    <!-- ========== 抽屉式工具栏 ========== -->

    <!--
      layout_height 由代码控制（收起 30dp / 展开 190dp，拖动时跟手）。
      这里给的初始值就是收起状态。
    -->
    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:background="@drawable/drawer_top"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 把手：整个抽屉的拖拽区，也是收起时唯一可见的部分 -->
        <FrameLayout
            android:id="@+id/grabber"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:clickable="true"
            android:focusable="true">

            <View
                android:layout_width="38dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="@drawable/grabber" />
        </FrameLayout>

        <!--
          抽屉内容。

          注意外面套了一层 ScrollView：横屏或小屏上抽屉展开后
          可能放不下所有工具，允许滚动总比裁掉强。
          拖动时这一层不参与手势（把手才是拖拽区），不会打架。
        -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="2dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

                <!-- 第一行：绘制工具 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toolGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/toolPen"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="@string/tool_pen"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/toolEraser"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="@string/tool_eraser"
                            android:textSize="12sp" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnColor"
                        style="@style/ToolButton"
                        android:layout_marginStart="6dp"
                        android:text="@string/tool_color" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWidth"
                        style="@style/ToolButton"
                        android:text="@string/width_mid" />
                </LinearLayout>

                <!-- 第二行：贴纸 / 描画 / 缩放 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSticker"
                        style="@style/ToolButton"
                        android:text="@string/tool_sticker" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStickerDelete"
                        style="@style/ToolButton"
                        android:text="@string/tool_sticker_remove"
                        android:textColor="@color/danger"
                        android:visibility="gone" />

                    <!--
                      锁定贴纸。

                      贴上之后点一下锁住，这张贴纸就不再拦截触摸 ——
                      用户可以从它上面直接画过去，不用怕一点就选中它。
                    -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStickerLock"
                        style="@style/ToolButton"
                        android:text="@string/sticker_lock"
                        android:textColor="@color/aurora"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTracing"
                        style="@style/ToolButton"
                        android:text="@string/tool_tracing" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnZoom"
                        style="@style/ToolButton"
                        android:text="@string/tool_zoom" />
                </LinearLayout>

                <!-- 第三行：纸张 / 撤销 / 清空 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/paperGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/paperWhite"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/paper_white"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/paperGrid"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/paper_grid"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/paperCream"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/paper_cream"
                            android:textSize="12sp" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUndo"
                        style="@style/ToolButton"
                        android:text="@string/action_undo" />
                </LinearLayout>

                <!-- 第四行：发送（唯一的主操作） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClear"
                        style="@style/ToolButton"
                        android:text="@string/action_clear"
                        android:textColor="@color/ink_secondary" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSend"
                        style="@style/PrimaryAction"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:minWidth="140dp"
                        android:text="@string/action_send"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- 颜色面板里的色点由代码填充，这里只放容器 -->
    <LinearLayout
        android:id="@+id/colorRow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
