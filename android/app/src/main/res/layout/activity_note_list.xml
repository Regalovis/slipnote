<?xml version="1.0" encoding="utf-8"?>
<!--
  收件箱 / 收藏夹列表。

  和首页同一套语言：**圆头像 + 名字 + 摘要**。
  原型里这两个页面的行长得一样 —— 首页是"扫一眼最近"，这里是"翻全部"，
  区别只在数量，不在形态。保持一致用户才不用重新认一遍。

  行本身由代码构建（缩略图要解码、贴纸要查库），
  所以这里只有一个空容器。

  顶部那行是「返回 + 标题 + 条数」——
  子页靠左上角返回，不用底部导航条（那是早期系统应用的形态）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/TopBarButton"
            android:contentDescription="@string/action_back"
            app:icon="@drawable/ic_back" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:letterSpacing="-0.01"
            android:textColor="@color/ink_on_paper"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="@color/hint_on_paper"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.5"
                android:paddingStart="8dp"
                android:paddingTop="48dp"
                android:paddingEnd="8dp"
                android:paddingBottom="48dp"
                android:textColor="@color/ink_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
